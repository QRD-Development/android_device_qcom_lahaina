android_app {
    name: "QcomParts",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "org.lineageos.settings.resources",
        "SettingsLib",
    ],
}
