on boot
    chown system system /sys/devices/platform/soc/990000.i2c/i2c-0/0-0038/fts_glove_mode

service vendor.touch-hal /vendor/bin/hw/vendor.lineage.touch-service.lahaina
    class hal
    user system
    group system
